  "about": {
    "badge": "About us",
    "title": "Your virtual guide to the island",
    "intro": "We are a modern company building a product designed to be your virtual guide across Tenerife.",
    "p1": "Teney brings together reliable place data, practical details, and a calm interface — so planning a day by the ocean or in the mountains feels simple, not overwhelming.",
    "p2": "We are growing the platform step by step: starting with beaches, then expanding into more places and local knowledge that visitors and residents actually need.",
    "p3": "Our goal is one trustworthy source about the island — clear, multilingual, and always within reach on your phone or laptop."
