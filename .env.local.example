# Base URL of the Spring Boot API (no trailing slash). Browser / Capacitor WebView.
#
# Local:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
#
# Railway (service → Variables): use the public URL of your API service, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://tenedevia-api-production.up.railway.app
#
# Important: NEXT_PUBLIC_* is baked in at `next build`. After changing it on Railway,
# trigger a new deploy (Redeploy), not only a service restart.
